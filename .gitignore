# macOS and editor state
.DS_Store

# Deliberate divergence from fleet sections that track stores: this public boundary gives up
# transfer-unit behavior. Clones carry no Symphony tasks, decisions, or knowledge; local store
# documents have no Git history. Federation reads the local store from disk, so lint/queries work.
.symphony/
*.swp
*~

# Xcode/Swift derived outputs and local IDE state
.build/
DerivedData/
build/
xcuserdata/
*.xcuserstate
*.xcresult
.swiftpm/

# Generated packages, local hand-offs, caches, and scratch data
dist/
handoff/
scratch/
*.app
*.dmg
*.pkg
*.zip
__pycache__/
*.py[cod]

# Credentials and machine-local configuration must never enter Git.
.env
.env.*
!.env.example
*.p12
*.pem
*.key
*.mobileprovision
.pi/*
!.pi/extensions/
