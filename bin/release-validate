#!/bin/sh
# Validate the source-controlled stable release identity. No network access is used.
set -eu

version_file=${VERSION_FILE:-VERSION}
changelog_file=${CHANGELOG_FILE:-CHANGELOG.md}
version=$(tr -d '\r\n' < "$version_file")

if ! printf '%s\n' "$version" | grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
  echo "REFUSING: VERSION is not stable SemVer" >&2
  exit 1
fi

# RELEASE_TAG is passed explicitly by the tag-only workflow; ordinary CI has no tag check.
tag=${RELEASE_TAG:-}
if test -n "$tag" && test "$tag" != "v$version"; then
  echo "REFUSING: tag $tag does not match VERSION $version" >&2
  exit 1
fi

if ! grep -Eq "^## \[$version\] - [0-9]{4}-[0-9]{2}-[0-9]{2}$" "$changelog_file"; then
  echo "REFUSING: CHANGELOG.md has no dated [$version] heading" >&2
  exit 1
fi
